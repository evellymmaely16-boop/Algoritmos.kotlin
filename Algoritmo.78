/**
 * Algoritmo 78
 * Objetivo: Ler o número de lados de um polígono convexo e calcular o 
 * número de diagonais diferentes.
 */

fun main() {
    print("Digite o número de lados do polígono: ")
    val n = readlnOrNull()?.toIntOrNull() ?: 0
    val nd = n * (n - 3) / 2
    println("\nNúmero de diagonais: $nd")
}

